<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="../Gamegrl.Rhi/Gamegrl.Rhi.csproj" />
    <ProjectReference Include="../Gamegrl.Platform/Gamegrl.Platform.csproj" />
    <ProjectReference Include="../Gamegrl.Assets/Gamegrl.Assets.csproj" />
  </ItemGroup>

  <!--
    Shaders: GLSL compiled offline to SPIR-V and embedded. Editor-time only; players ship bytecode.
    TODO: move to Slang (one source, SPIR-V/WGSL/MSL/DXIL) once it's installed.
  -->
  <ItemGroup>
    <Shader Include="Shaders/*.vert;Shaders/*.frag" />
  </ItemGroup>
  <Target Name="CompileShaders" BeforeTargets="BeforeBuild" Inputs="@(Shader)" Outputs="@(Shader->'$(IntermediateOutputPath)shaders/%(Filename)%(Extension).spv')">
    <MakeDir Directories="$(IntermediateOutputPath)shaders" />
    <Exec Command="glslc -O --target-env=vulkan1.3 &quot;%(Shader.FullPath)&quot; -o &quot;$(IntermediateOutputPath)shaders/%(Shader.Filename)%(Shader.Extension).spv&quot;" />
  </Target>
  <Target Name="EmbedShaders" BeforeTargets="BeforeBuild" AfterTargets="CompileShaders">
    <ItemGroup>
      <EmbeddedResource Include="@(Shader->'$(IntermediateOutputPath)shaders/%(Filename)%(Extension).spv')" LogicalName="shaders/%(Filename)%(Extension).spv" />
    </ItemGroup>
  </Target>
</Project>
